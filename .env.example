PORT=4000

FLEXISIP_DB_HOST=
FLEXISIP_DB_PORT=3306
FLEXISIP_DB_USER=
FLEXISIP_DB_PASSWORD=
FLEXISIP_DB_NAME=flexisip

# When "true", starting the app will auto-create the `accounts` table (from
# db/schema/accounts.sql) if it doesn't already exist in FLEXISIP_DB_NAME.
# This is a local/test convenience ONLY, so pointing .env at a fresh empty
# database and starting the app just works.
#
# THIS MUST NEVER BE SET TO "true" IN PRODUCTION. If a misconfigured
# connection is ever accidentally pointed at the real production database
# with this enabled, it should fail loudly (the default, safe behavior)
# rather than silently creating a table there.
AUTO_CREATE_SCHEMA=false

ADMIN_DB_HOST=
ADMIN_DB_PORT=3306
ADMIN_DB_USER=
ADMIN_DB_PASSWORD=
ADMIN_DB_NAME=auth_admins

JWT_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

ADMIN_PANEL_URL=
